server {
    listen 443 ssl http2;
    server_name runner.example.edu;

    # Configure your TLS certificate here.
    # ssl_certificate /etc/letsencrypt/live/runner.example.edu/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/runner.example.edu/privkey.pem;

    client_max_body_size 96k;

    location / {
        proxy_pass http://127.0.0.1:5080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
