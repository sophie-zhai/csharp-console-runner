[Unit]
Description=C# Exam Runner API
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User=csharprunner
Group=csharprunner
WorkingDirectory=/opt/csharp-runner
Environment=ASPNETCORE_URLS=http://127.0.0.1:5080
Environment=ASPNETCORE_ENVIRONMENT=Production
ExecStart=/usr/bin/dotnet /opt/csharp-runner/Runner.Api.dll
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/csharp-runner/runner-work

[Install]
WantedBy=multi-user.target
